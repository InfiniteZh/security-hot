# Copy to .env and fill in.

# Comma-separated origin allowlist for the FastAPI CORS middleware.
# Defaults to localhost:8000 + 127.0.0.1:8000 when unset.
# Use "*" to allow any origin (NOT recommended in production).
SECURITY_HOT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Bearer token required by POST /api/refresh. Unset = endpoint disabled.
# Use `openssl rand -hex 32` to generate something durable.
SECURITY_HOT_REFRESH_TOKEN=

# Optional: GitHub token for nuclei / malpkgs fetchers (lifts 60→5000 req/h).
GITHUB_TOKEN=

# Optional: MurphySec vuln_warn integration. Always uses scope=default with a
# last_modify_time window; no local cache means "look back N minutes", not full sync.
MURPHY_CUSTOMER_CODE=
MURPHY_INITIAL_LOOKBACK_MINUTES=240

# Optional: LLM endpoint for priority-ranking news articles (Layer 3 in
# scripts/llm_rank.py). When LLM_API_KEY is set, fetch_data.py auto-runs
# the ranker on every news fetch (incremental — only un-scored articles).
# Endpoint must speak OpenAI-style chat completions (MiniMax / DeepSeek /
# Qwen / OpenAI / Together / Anthropic-via-proxy all qualify).
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=abab6.5s-chat
LLM_CONCURRENCY=8
LLM_BATCH_SIZE=25
LLM_MAX_BATCHES=200

# Optional: extra keyword blocklist for Layer 2 article filter (comma list).
# Default already blocks 招聘 / 限免 / 议程公布 etc.
NEWS_BLOCK_KEYWORDS=

# In-process scheduler (backend/app/scheduler.py). Lets a Docker deployment
# auto-refresh the pipeline with no host crontab or sidecar. Off by default so
# local dev / tests don't spawn heavy LLM subprocesses; docker-compose turns it
# on for the `web` service. Do not enable it with `uvicorn --reload`; reload
# can briefly overlap app processes and duplicate scheduled jobs. Cadence mirrors
# docs/cron-template.txt.
SECURITY_HOT_SCHEDULER_ENABLED=0
SECURITY_HOT_FETCH_NEWS_MINUTES=15
SECURITY_HOT_PIPELINE_HOURS=2
SECURITY_HOT_FETCH_OTHER_HOURS=4
SECURITY_HOT_BRIEF_HOUR_UTC=23

# News retention window in days. fetch_data drops RSS entries older than this,
# and the cleanup helper purges already-stored articles past the cutoff.
# Lower = leaner DB + faster queries; higher = more historical context.
NEWS_DAYS_BACK=30

# ── 投毒情报 Kafka 投送（poisoning_dispatch.py）──
# 把"可处置"的供应链投毒情报投到 Kafka，触发 security_copilot disposal。
KAFKA_BOOTSTRAP=kafka01-devsecops-cnhbnp01-test.chj.cloud:9092,kafka02-devsecops-cnhbnp01-test.chj.cloud:9092,kafka03-devsecops-cnhbnp01-test.chj.cloud:9092
KAFKA_TOPIC=schedule_task_normal
